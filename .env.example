# Google AI Studio API key (the free tier is enough; no card needed). GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=

# Gemini model id used for reviews. Stable ids with a free tier (October 2026): gemini-3.8-flash (best notes),
# gemini-3.5-flash-lite (cheaper, higher daily quota). npm run models lists what your key can use.
GEMINI_MODEL=gemini-3.8-flash
