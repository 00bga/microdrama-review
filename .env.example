# Google AI Studio API key (the free tier is enough; no card needed). GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=

# Gemini model ids used for reviews: one id, or several separated by commas. The next one is tried when
# the one before is overloaded (503 or 504), which happens on the free tier at busy hours. Stable ids with
# a free tier (October 2026): gemini-3.8-flash (best notes), gemini-3.6-flash, gemini-3.5-flash-lite
# (cheaper, higher daily quota). npm run models lists what your key can use.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Review configuration (every line optional; unset keeps the code default, which is the measured
# configuration described in docs/accuracy.md).
# Prompt arm: P = the round-1 text with its examples purged (the baseline), A = the round-2 text, AB = A plus a shot list per block, AC = A plus a problem slot per listed shot.
GEMINI_ARM=
# How many strategist notes from other episodes are shown as a style sample (0 to 15); 0 turns the section off.
GEMINI_EXEMPLARS=
# Frames per second the model sees (the API default is 1; measured as an exploratory arm, see docs/accuracy.md).
GEMINI_FPS=
# Media resolution for the video part: low, medium or high (unset keeps the API default).
GEMINI_RESOLUTION=
# Thinking level for models that report thought tokens: minimal, low, medium or high (unset keeps the model default).
GEMINI_THINKING=
# A fixed seed makes a re-run as repeatable as the API allows; unset means a fresh draw on every run.
GEMINI_SEED=
