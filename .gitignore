# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (uploads, SQLite)
/data/

# keep the env template
!.env.example

# local tooling (never committed)
scripts/check-em-dash.mjs

# SQLite files anywhere, and the agent file next dev can write
*.db
*.db-wal
*.db-shm
*.sqlite*
/AGENTS.md
